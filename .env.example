# Astelio IME のローカル設定。このファイルを .env にコピーして値を入れる（.env はGitの管理対象外）

# 辞書作成環境: ローカルのモデルサーバー（OpenAI互換API）
ASTELIO_LLM_BASE_URL=http://localhost:11434/v1

# Windows: コード署名（フェーズ8）
ASTELIO_SIGN_CERT_PATH=
ASTELIO_SIGN_CERT_PASSWORD=

# macOS: 署名と公証（フェーズ8）
APPLE_TEAM_ID=
APPLE_ID=
APPLE_APP_SPECIFIC_PASSWORD=
