<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The Mac App Store requires the App Sandbox. The user's data then lives in the container
	     (~/Library/Containers/<bundle id>/Data/Library/Application Support/AstelioIME). No temporary exceptions. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- InputMethodKit publishes the connection under InputMethodConnectionName (Info.plist). The sandbox lets an app
	     register Mach services whose names start with one of its app groups and a dot, so the name is
	     "<app group>.Connection". -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>$(ASTELIO_APP_GROUP)</string>
	</array>
	<!-- The save panel of the setup tab: the user chooses where the link to this app goes (~/Library/Input Methods). -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
</dict>
</plist>
