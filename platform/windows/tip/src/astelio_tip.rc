#include <winres.h>

#include "astelio_version.h"

// The first icon: the input method lists show it (RegisterProfile uses index 0).
1 ICON "../../../../assets/icon/AstelioIME.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION ASTELIO_VERSION_MAJOR, ASTELIO_VERSION_MINOR, ASTELIO_VERSION_PATCH, 0
PRODUCTVERSION ASTELIO_VERSION_MAJOR, ASTELIO_VERSION_MINOR, ASTELIO_VERSION_PATCH, 0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041104B0"
        BEGIN
            VALUE "CompanyName", "Geek Fujiwara"
            VALUE "FileDescription", "Astelio IME"
            VALUE "FileVersion", ASTELIO_VERSION_TEXT
            VALUE "InternalName", "astelio_tip"
            VALUE "LegalCopyright", "Copyright (c) 2026 Geek Fujiwara. MIT License."
            VALUE "OriginalFilename", "astelio_tip.dll"
            VALUE "ProductName", "Astelio IME"
            VALUE "ProductVersion", ASTELIO_VERSION_TEXT
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0411, 1200
    END
END
