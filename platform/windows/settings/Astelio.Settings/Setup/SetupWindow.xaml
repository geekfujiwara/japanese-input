<Window x:Class="Astelio.Settings.Setup.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tour="clr-namespace:Astelio.Settings.Tour"
        Title="Astelio IME のセットアップ"
        Width="900" Height="640" MinWidth="820" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/AstelioIME.png">
  <Window.Resources>
    <Style x:Key="Lead" TargetType="TextBlock">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="LineHeight" Value="24" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>
    <Storyboard x:Key="Float" RepeatBehavior="Forever" AutoReverse="True">
      <DoubleAnimation Storyboard.TargetName="HeroLogoMove" Storyboard.TargetProperty="Y" From="0" To="-10" Duration="0:0:3">
        <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
      </DoubleAnimation>
      <DoubleAnimation Storyboard.TargetName="HeroLogoTurn" Storyboard.TargetProperty="Angle" From="-3" To="4" Duration="0:0:3">
        <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
      </DoubleAnimation>
    </Storyboard>
  </Window.Resources>

  <DockPanel>
    <!-- Buttons -->
    <Border DockPanel.Dock="Bottom" Padding="28,14" BorderThickness="0,1,0,0"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}">
      <DockPanel>
        <TextBlock x:Name="StepText" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button x:Name="BackButton" Content="戻る" MinWidth="96" Margin="0,0,8,0" Click="OnBack" />
          <Button x:Name="NextButton" Content="次へ" MinWidth="120" Margin="0,0,8,0" Click="OnNext" IsDefault="True"
                  Style="{DynamicResource AccentButtonStyle}" />
          <Button x:Name="CancelButton" Content="キャンセル" MinWidth="96" Click="OnCancel" IsCancel="True" />
        </StackPanel>
      </DockPanel>
    </Border>

    <Grid>
      <!-- 1. Welcome -->
      <Grid x:Name="WelcomePage">
        <Grid.Background>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#1A1B5E" Offset="0" />
            <GradientStop Color="#6B3FE6" Offset="0.55" />
            <GradientStop Color="#12C8E6" Offset="1" />
          </LinearGradientBrush>
        </Grid.Background>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="640">
          <Image Source="pack://application:,,,/Assets/AstelioIME.png" Width="132" Height="132" RenderTransformOrigin="0.5,0.5">
            <Image.RenderTransform>
              <TransformGroup>
                <RotateTransform x:Name="HeroLogoTurn" />
                <TranslateTransform x:Name="HeroLogoMove" />
              </TransformGroup>
            </Image.RenderTransform>
            <Image.Effect>
              <DropShadowEffect BlurRadius="28" ShadowDepth="10" Opacity="0.35" />
            </Image.Effect>
          </Image>
          <TextBlock Text="Astelio IME へようこそ" FontSize="34" FontWeight="SemiBold" Foreground="White"
                     HorizontalAlignment="Center" Margin="0,22,0,6" />
          <TextBlock Text="英語配列のキーボードで、もっと気持ちよく日本語を。" FontSize="17" Foreground="White" Opacity="0.92"
                     HorizontalAlignment="Center" />
          <UniformGrid Columns="3" Margin="0,34,0,0">
            <Border CornerRadius="14" Background="#26FFFFFF" Padding="14,12" Margin="6">
              <StackPanel>
                <TextBlock Text="Alt 1回で切り替え" Foreground="White" FontWeight="SemiBold" FontSize="15" />
                <TextBlock Text="右 Alt で日本語、左 Alt で英語。今どちらかを気にしない" Foreground="White" Opacity="0.85"
                           TextWrapping="Wrap" Margin="0,4,0,0" />
              </StackPanel>
            </Border>
            <Border CornerRadius="14" Background="#26FFFFFF" Padding="14,12" Margin="6">
              <StackPanel>
                <TextBlock Text="打ち間違いに強い" Foreground="White" FontWeight="SemiBold" FontSize="15" />
                <TextBlock Text="予測と「もしかして」で、正しい語をすぐに" Foreground="White" Opacity="0.85"
                           TextWrapping="Wrap" Margin="0,4,0,0" />
              </StackPanel>
            </Border>
            <Border CornerRadius="14" Background="#26FFFFFF" Padding="14,12" Margin="6">
              <StackPanel>
                <TextBlock Text="PC の中だけで動く" Foreground="White" FontWeight="SemiBold" FontSize="15" />
                <TextBlock Text="入力した内容を外部に送らない。オープンソース" Foreground="White" Opacity="0.85"
                           TextWrapping="Wrap" Margin="0,4,0,0" />
              </StackPanel>
            </Border>
          </UniformGrid>
        </StackPanel>
      </Grid>

      <!-- 2. Tour (also shown while installing) -->
      <Grid x:Name="TourPage" Margin="32,26,32,18">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
          <TextBlock x:Name="TourHeading" Text="Astelio IME でできること" FontSize="26" FontWeight="SemiBold" />
          <ProgressBar x:Name="InstallProgress" Height="6" Margin="0,12,0,4" Maximum="1" Visibility="Collapsed" />
          <TextBlock x:Name="InstallStatus" Visibility="Collapsed" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>
        <Grid Grid.Row="1" Margin="0,16,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.8*" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="1.2*" />
          </Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center">
            <TextBlock x:Name="DemoNumber" FontSize="13" FontWeight="SemiBold" Foreground="#6B3FE6" />
            <TextBlock x:Name="DemoTitle" FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,10" />
            <TextBlock x:Name="DemoDescription" Style="{StaticResource Lead}" />
          </StackPanel>
          <tour:DemoStage x:Name="Stage" Grid.Column="2" Finished="OnDemoFinished" />
        </Grid>
        <DockPanel Grid.Row="2" Margin="0,12,0,0">
          <StackPanel x:Name="DemoDots" Orientation="Horizontal" VerticalAlignment="Center" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="&#xE76B;" FontFamily="{StaticResource IconFont}" Margin="0,0,6,0" Click="OnPreviousDemo"
                    AutomationProperties.Name="前の紹介" />
            <Button Content="&#xE76C;" FontFamily="{StaticResource IconFont}" Click="OnNextDemo"
                    AutomationProperties.Name="次の紹介" />
          </StackPanel>
        </DockPanel>
      </Grid>

      <!-- 3. Ready -->
      <ScrollViewer x:Name="ReadyPage" VerticalScrollBarVisibility="Auto" Padding="40,30">
        <StackPanel MaxWidth="720" HorizontalAlignment="Left">
          <TextBlock Text="インストールの準備ができました" FontSize="26" FontWeight="SemiBold" Margin="0,0,0,12" />
          <TextBlock Style="{StaticResource Lead}"
                     Text="「インストール」を押すと、Windows の確認（ユーザーアカウント制御）が出ます。「はい」を選ぶと始まります。" />
          <Border Style="{StaticResource Card}" Margin="0,20,0,8">
            <StackPanel>
              <TextBlock Style="{StaticResource SettingTitle}" Text="入るもの" />
              <TextBlock Style="{StaticResource Description}" x:Name="InstallContents" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Style="{StaticResource SettingTitle}" Text="ライセンス" />
              <TextBlock Style="{StaticResource Description}"
                         Text="Astelio IME は MIT ライセンスのオープンソースソフトウェアです。辞書は azooKey_dictionary_storage（Apache-2.0）を使っています。" />
              <WrapPanel Margin="0,10,0,0">
                <Button Content="ライセンスを読む" Click="OnShowLicense" Margin="0,0,8,0" />
                <Button Content="ソースコード（GitHub）" Click="OnOpenLink" Tag="https://github.com/geekfujiwara/japanese-input" />
              </WrapPanel>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Style="{StaticResource SettingTitle}" Text="プライバシー" />
              <TextBlock Style="{StaticResource Description}"
                         Text="Astelio IME はインターネットに接続しません。入力した内容を外部に送ったり、ログに書いたりしません。" />
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <!-- 5. First settings (R-08) -->
      <ScrollViewer x:Name="FirstSettingsPage" VerticalScrollBarVisibility="Auto" Padding="40,30">
        <StackPanel MaxWidth="720" HorizontalAlignment="Left">
          <TextBlock Text="はじめの設定" FontSize="26" FontWeight="SemiBold" Margin="0,0,0,8" />
          <TextBlock Style="{StaticResource Lead}" Text="あとから「Astelio IME の設定」でいつでも変えられます。" Margin="0,0,0,16" />
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <CheckBox x:Name="FirstLearning" Content="選んだ候補を覚えて、次の変換に使う（入力の履歴）" />
              <CheckBox x:Name="FirstTypo" Content="打ち間違いに「もしかして」の候補を出す" Margin="0,8,0,0" />
              <CheckBox x:Name="FirstShared" Content="入力モード（ひらがな／英数）をすべてのアプリで共有する" Margin="0,8,0,0" />
              <CheckBox x:Name="FirstListPeriod" Content="行頭の「1.」の「.」を半角のまま入力する" Margin="0,8,0,0" />
              <CheckBox x:Name="FirstBrackets" Content="かっこを閉じかっこと一緒に入力する" Margin="0,8,0,0" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}">
            <DockPanel>
              <ComboBox x:Name="FirstDateFormat" DockPanel.Dock="Right" MinWidth="240" VerticalAlignment="Center"
                        AutomationProperties.Name="日付の表記" />
              <TextBlock Style="{StaticResource SettingTitle}" Text="「きょう」で最初に出す日付" VerticalAlignment="Center" />
            </DockPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <!-- 6. Done / failed -->
      <Grid x:Name="DonePage">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="640">
          <Image Source="pack://application:,,,/Assets/AstelioIME.png" Width="96" Height="96" />
          <TextBlock x:Name="DoneTitle" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,18,0,10"
                     TextWrapping="Wrap" TextAlignment="Center" />
          <TextBlock x:Name="DoneText" Style="{StaticResource Lead}" TextAlignment="Center" />
          <Border x:Name="RestartCard" Style="{StaticResource Card}" Margin="0,18,0,0">
            <DockPanel>
              <Button DockPanel.Dock="Right" Content="今すぐ再起動" VerticalAlignment="Center" Click="OnRestart" />
              <TextBlock Style="{StaticResource Description}" Margin="0,0,16,0" VerticalAlignment="Center"
                         Text="使用中だったファイルは、PC を再起動すると新しくなります。" />
            </DockPanel>
          </Border>
          <WrapPanel x:Name="DoneLinks" HorizontalAlignment="Center" Margin="0,18,0,0">
            <Button Content="設定を開く" Click="OnOpenSettings" Margin="0,0,8,0" />
            <Button x:Name="LogButton" Content="ログを開く" Click="OnOpenLog" />
          </WrapPanel>
        </StackPanel>
      </Grid>
    </Grid>
  </DockPanel>
</Window>
