<Window x:Class="Astelio.Settings.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tour="clr-namespace:Astelio.Settings.Tour"
        Title="Astelio IME の設定"
        Width="940" Height="660" MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/AstelioIME.png">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="248" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- Navigation -->
    <DockPanel Grid.Column="0" Margin="8,12,4,12">
      <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="12,4,0,18">
        <Image Source="pack://application:,,,/Assets/AstelioIME.png" Width="32" Height="32" />
        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="Astelio IME" FontSize="16" FontWeight="SemiBold" />
          <TextBlock Text="設定" Opacity="0.72" />
        </StackPanel>
      </StackPanel>
      <ListBox x:Name="Navigation" BorderThickness="0" Background="Transparent"
               SelectionChanged="OnNavigate" AutomationProperties.Name="設定の項目">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel Orientation="Horizontal" Margin="4,6">
              <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="16"
                         VerticalAlignment="Center" Width="28" />
              <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>

    <ScrollViewer Grid.Column="1" x:Name="PageScroller" VerticalScrollBarVisibility="Auto" Padding="28,20,28,24">
      <Grid MaxWidth="760" HorizontalAlignment="Left">

        <!-- 全般 -->
        <StackPanel x:Name="GeneralPage">
          <TextBlock Style="{StaticResource PageTitle}" Text="全般" />
          <Border x:Name="CurrentAppCard" Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock x:Name="CurrentAppTitle" Style="{StaticResource SettingTitle}" />
              <TextBlock Style="{StaticResource Description}"
                         Text="設定を開いたアプリだけに効く設定です。ほかのアプリの分は「アプリごとの設定」で変えられます。" />
              <CheckBox x:Name="CurrentAppDisabled" Margin="0,10,0,0" Content="このアプリでは Astelio IME を使わない"
                        Click="OnCurrentAppDisabled" />
              <CheckBox x:Name="CurrentAppNoLearning" Margin="0,6,0,0" Content="このアプリでは入力履歴を記録しない"
                        Click="OnCurrentAppNoLearning" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <CheckBox x:Name="SharedInputMode" Click="OnFlag" Tag="SharedInputMode">
                <TextBlock Style="{StaticResource SettingTitle}" Text="入力モード（ひらがな／英数）をすべてのアプリで共有する" />
              </CheckBox>
              <TextBlock Style="{StaticResource Description}"
                         Text="オフにすると、アプリごとに入力モードを覚えます。" />
            </StackPanel>
          </Border>
          <Button Content="既定に戻す" HorizontalAlignment="Left" Margin="0,12,0,0" Click="OnReset" Tag="SharedInputMode" />
        </StackPanel>

        <!-- 入力補助 -->
        <StackPanel x:Name="TypingPage">
          <TextBlock Style="{StaticResource PageTitle}" Text="入力補助" />
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <CheckBox x:Name="ListNumberPeriod" Click="OnFlag" Tag="ListNumberPeriod">
                <TextBlock Style="{StaticResource SettingTitle}" Text="行頭の「1.」の「.」を半角のまま入力する" />
              </CheckBox>
              <TextBlock Style="{StaticResource Description}"
                         Text="番号付きの箇条書きを書きやすくします。オフにすると「1。」になります。" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <CheckBox x:Name="AutoCloseBrackets" Click="OnFlag" Tag="AutoCloseBrackets">
                <TextBlock Style="{StaticResource SettingTitle}" Text="かっこを閉じるかっこと一緒に入力する" />
              </CheckBox>
              <TextBlock Style="{StaticResource Description}"
                         Text="「（」を入力すると「（）」になり、カーソルが中に入ります。" />
            </StackPanel>
          </Border>
          <Button Content="既定に戻す" HorizontalAlignment="Left" Margin="0,12,0,0" Click="OnReset"
                  Tag="ListNumberPeriod AutoCloseBrackets" />
        </StackPanel>

        <!-- 変換 -->
        <StackPanel x:Name="ConversionPage">
          <TextBlock Style="{StaticResource PageTitle}" Text="変換" />
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <CheckBox x:Name="TypoSuggestions" Click="OnFlag" Tag="TypoSuggestions">
                <TextBlock Style="{StaticResource SettingTitle}" Text="入力の間違いを見つけたら「もしかして」の候補を出す" />
              </CheckBox>
              <TextBlock Style="{StaticResource Description}"
                         Text="打ち間違いと思われる読みに、正しいと思われる変換を添えます。" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}">
            <DockPanel>
              <ComboBox x:Name="DateFormat" DockPanel.Dock="Right" MinWidth="260" VerticalAlignment="Center"
                        SelectionChanged="OnDateFormat" AutomationProperties.Name="日付の表記" />
              <StackPanel Margin="0,0,16,0">
                <TextBlock Style="{StaticResource SettingTitle}" Text="「きょう」「あした」で最初に出す日付の表記" />
                <TextBlock Style="{StaticResource Description}"
                           Text="ほかの表記も候補に出ます。日付の候補を選ぶと、その表記を覚えて次から先に出します。" />
              </StackPanel>
            </DockPanel>
          </Border>
          <Button Content="既定に戻す" HorizontalAlignment="Left" Margin="0,12,0,0" Click="OnReset"
                  Tag="TypoSuggestions DateFormat" />
        </StackPanel>

        <!-- 入力の履歴 -->
        <StackPanel x:Name="HistoryPage">
          <TextBlock Style="{StaticResource PageTitle}" Text="入力の履歴" />
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <CheckBox x:Name="LearningEnabled" Click="OnFlag" Tag="LearningEnabled">
                <TextBlock Style="{StaticResource SettingTitle}" Text="選んだ候補を覚えて、次の変換に使う" />
              </CheckBox>
              <TextBlock Style="{StaticResource Description}"
                         Text="履歴はこの PC の中だけに保存し、外部には送りません。パスワードの欄では記録しません。" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <CheckBox x:Name="LearningPaused" Click="OnFlag" Tag="LearningPaused">
                <TextBlock Style="{StaticResource SettingTitle}" Text="記録を一時停止する（シークレットモード）" />
              </CheckBox>
              <TextBlock Style="{StaticResource Description}"
                         Text="これまでの履歴は変換に使い続けますが、新しく記録しません。" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}">
            <DockPanel>
              <Button DockPanel.Dock="Right" Content="入力履歴の管理..." VerticalAlignment="Center"
                      Click="OnOpenLearningHistory" />
              <StackPanel Margin="0,0,16,0">
                <TextBlock Style="{StaticResource SettingTitle}" Text="覚えた変換を見る・消す" />
                <TextBlock Style="{StaticResource Description}"
                           Text="一つずつ消したり、期間を指定してまとめて消したりできます。" />
              </StackPanel>
            </DockPanel>
          </Border>
          <Button Content="既定に戻す" HorizontalAlignment="Left" Margin="0,12,0,0" Click="OnReset"
                  Tag="LearningEnabled LearningPaused" />
        </StackPanel>

        <!-- ユーザー辞書 -->
        <StackPanel x:Name="DictionaryPage">
          <TextBlock Style="{StaticResource PageTitle}" Text="ユーザー辞書" />
          <Border Style="{StaticResource Card}">
            <DockPanel>
              <Button DockPanel.Dock="Right" Content="ユーザー辞書を開く..." VerticalAlignment="Center"
                      Click="OnOpenUserDictionary" />
              <StackPanel Margin="0,0,16,0">
                <TextBlock Style="{StaticResource SettingTitle}" Text="単語の登録・編集" />
                <TextBlock Style="{StaticResource Description}"
                           Text="名前や専門用語など、辞書にない言葉を読みと一緒に登録します。ファイルからの取り込みと書き出しもできます。" />
              </StackPanel>
            </DockPanel>
          </Border>
        </StackPanel>

        <!-- アプリごとの設定 -->
        <StackPanel x:Name="AppsPage">
          <TextBlock Style="{StaticResource PageTitle}" Text="アプリごとの設定" />
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Style="{StaticResource SettingTitle}" Text="Astelio IME を使わないアプリ" />
              <TextBlock Style="{StaticResource Description}"
                         Text="ゲームやリモートデスクトップなど、キーをそのまま送りたいアプリに使います。" />
              <ListBox x:Name="DisabledApps" Margin="0,10,0,0" MinHeight="72" MaxHeight="180"
                       AutomationProperties.Name="Astelio IME を使わないアプリ" />
              <DockPanel Margin="0,8,0,0">
                <Button DockPanel.Dock="Right" Content="削除" Margin="8,0,0,0" Click="OnRemoveApp" Tag="DisabledApps" />
                <Button DockPanel.Dock="Right" Content="追加" Margin="8,0,0,0" Click="OnAddApp" Tag="DisabledApps" />
                <ComboBox x:Name="DisabledAppInput" IsEditable="True" DropDownOpened="OnListRunningApps"
                          AutomationProperties.Name="追加するアプリの名前（例: notepad.exe）" />
              </DockPanel>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Style="{StaticResource SettingTitle}" Text="入力履歴を記録しないアプリ" />
              <TextBlock Style="{StaticResource Description}"
                         Text="パスワード管理ソフトや、人に見せる画面のアプリに使います。" />
              <ListBox x:Name="NoLearningApps" Margin="0,10,0,0" MinHeight="72" MaxHeight="180"
                       AutomationProperties.Name="入力履歴を記録しないアプリ" />
              <DockPanel Margin="0,8,0,0">
                <Button DockPanel.Dock="Right" Content="削除" Margin="8,0,0,0" Click="OnRemoveApp" Tag="NoLearningApps" />
                <Button DockPanel.Dock="Right" Content="追加" Margin="8,0,0,0" Click="OnAddApp" Tag="NoLearningApps" />
                <ComboBox x:Name="NoLearningAppInput" IsEditable="True" DropDownOpened="OnListRunningApps"
                          AutomationProperties.Name="追加するアプリの名前（例: notepad.exe）" />
              </DockPanel>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- 使い方 -->
        <StackPanel x:Name="GuidePage">
          <TextBlock Style="{StaticResource PageTitle}" Text="使い方" />
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <ComboBox x:Name="GuideDemos" HorizontalAlignment="Left" MinWidth="300" SelectionChanged="OnGuideDemo"
                        DisplayMemberPath="Title" AutomationProperties.Name="紹介する機能" />
              <TextBlock x:Name="GuideDescription" Style="{StaticResource Description}" Margin="0,10,0,12" />
              <tour:DemoStage x:Name="GuideStage" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}">
            <DockPanel>
              <Button DockPanel.Dock="Right" Content="ブラウザーで開く" VerticalAlignment="Center" Click="OnOpenGuide" />
              <StackPanel Margin="0,0,16,0">
                <TextBlock Style="{StaticResource SettingTitle}" Text="すべての使い方を1ページで" />
                <TextBlock Style="{StaticResource Description}"
                           Text="同じ説明をブラウザーで表示します（インターネットには接続しません）。" />
              </StackPanel>
            </DockPanel>
          </Border>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Style="{StaticResource SettingTitle}" Text="主なキー" />
              <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="180" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="右 Alt" Margin="0,3" /><TextBlock Grid.Row="0" Grid.Column="1" Text="ひらがな入力にする" Margin="0,3" />
                <TextBlock Grid.Row="1" Text="左 Alt" Margin="0,3" /><TextBlock Grid.Row="1" Grid.Column="1" Text="英数入力にする" Margin="0,3" />
                <TextBlock Grid.Row="2" Text="Space" Margin="0,3" /><TextBlock Grid.Row="2" Grid.Column="1" Text="変換する・次の候補" Margin="0,3" />
                <TextBlock Grid.Row="3" Text="Enter" Margin="0,3" /><TextBlock Grid.Row="3" Grid.Column="1" Text="確定する" Margin="0,3" />
                <TextBlock Grid.Row="4" Text="F6 〜 F10" Margin="0,3" /><TextBlock Grid.Row="4" Grid.Column="1" Text="ひらがな・カタカナ・半角カタカナ・全角英数・半角英数にする" Margin="0,3" />
                <TextBlock Grid.Row="5" Text="Esc" Margin="0,3" /><TextBlock Grid.Row="5" Grid.Column="1" Text="変換をやめる" Margin="0,3" />
              </Grid>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- このアプリについて (U-04) -->
        <StackPanel x:Name="AboutPage">
          <TextBlock Style="{StaticResource PageTitle}" Text="このアプリについて" />
          <Border Style="{StaticResource Card}" Padding="24,20">
            <StackPanel Orientation="Horizontal">
              <Border Width="88" Height="88" CornerRadius="20" Background="{StaticResource AccentGradient}">
                <Image Source="pack://application:,,,/Assets/AstelioIME.png" Width="68" Height="68" />
              </Border>
              <StackPanel Margin="20,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Astelio IME" FontSize="24" FontWeight="SemiBold" />
                <TextBlock x:Name="VersionText" Margin="0,2,0,0" Opacity="0.72" />
                <TextBlock Text="英語配列のキーボードのための日本語入力" Margin="0,8,0,0" />
                <TextBlock Text="開発: Geek Fujiwara" Margin="0,2,0,0" />
                <TextBlock x:Name="CopyrightText" Margin="0,2,0,0" Opacity="0.72" />
              </StackPanel>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Style="{StaticResource SettingTitle}" Text="ライセンス" />
              <TextBlock Style="{StaticResource Description}"
                         Text="MIT ライセンスで公開しています。同梱した辞書・ランタイムのライセンスは「第三者のライセンス」にあります。" />
              <WrapPanel Margin="0,10,0,0">
                <Button Content="第三者のライセンス" Click="OnOpenNotices" Margin="0,0,8,0" />
                <Button Content="ソースコード（GitHub）" Click="OnOpenLink"
                        Tag="https://github.com/geekfujiwara/japanese-input" Margin="0,0,8,0" />
                <Button Content="不具合・要望を送る" Click="OnOpenLink"
                        Tag="https://github.com/geekfujiwara/japanese-input/issues/new/choose" />
              </WrapPanel>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Style="{StaticResource SettingTitle}" Text="プライバシー" />
              <TextBlock Style="{StaticResource Description}"
                         Text="Astelio IME はインターネットに接続しません。入力した内容を外部に送ったり、ログに書いたりしません。" />
            </StackPanel>
          </Border>
        </StackPanel>

      </Grid>
    </ScrollViewer>
  </Grid>
</Window>
