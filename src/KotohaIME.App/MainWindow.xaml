<Window x:Class="KotohaIME.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Astelio IME" Icon="Assets/AstelioIME.ico" Height="650" Width="720"
        MinHeight="560" MinWidth="620"
        Background="#F3F5F1" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#202521" Padding="32,24">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Astelio IME" FontFamily="Yu Gothic UI Semibold"
                               FontSize="27" Foreground="White" />
                    <TextBlock Text="MS-IMEをそのまま使う、入力スタイル設定" Margin="0,5,0,0"
                               FontFamily="Yu Gothic UI" FontSize="13" Foreground="#CAD4CB" />
                </StackPanel>
                <Border Grid.Column="1" x:Name="StatusBadge" CornerRadius="4"
                        Background="#DDF2E4" Padding="12,6" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusText" Text="動作中" Foreground="#145D34"
                               FontFamily="Yu Gothic UI Semibold" FontSize="12" />
                </Border>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="32,24,32,20">
                <CheckBox x:Name="EnabledCheckBox" Content="入力カスタマイズを有効にする"
                          FontFamily="Yu Gothic UI Semibold" FontSize="16"
                          Checked="SettingChanged" Unchecked="SettingChanged" />
                <Separator Margin="0,14,0,18" Background="#D5DCD5" />

                <TextBlock Text="文字幅" FontFamily="Yu Gothic UI Semibold" FontSize="17"
                           Foreground="{StaticResource InkBrush}" />
                <CheckBox x:Name="AsciiCheckBox"
                          Content="数字・指定記号を半角で入力"
                          Checked="SettingChanged" Unchecked="SettingChanged" />
                <TextBlock Margin="26,-2,0,8" Foreground="{StaticResource MutedBrush}"
                           FontFamily="Yu Gothic UI" FontSize="12" TextWrapping="Wrap"
                           Text="英字は半角の未確定文字としてMS-IMEへ渡します。Shiftによる大文字入力と、スペースによる候補変換が使えます。" />
                <CheckBox x:Name="JapanesePunctuationCheckBox"
                          Content="「 」 ！ ？ ・ 。を半角で入力"
                          Checked="SettingChanged" Unchecked="SettingChanged" />

                <TextBlock Text="入力モード切替" Margin="0,24,0,4"
                           FontFamily="Yu Gothic UI Semibold" FontSize="17"
                           Foreground="{StaticResource InkBrush}" />
                <CheckBox x:Name="LeftAltCheckBox" Content="左Altの単独押しで英語入力へ切り替え"
                          Checked="SettingChanged" Unchecked="SettingChanged" />
                <CheckBox x:Name="RightAltCheckBox" Content="右Altの単独押しで日本語入力へ切り替え"
                          Checked="SettingChanged" Unchecked="SettingChanged" />

                <TextBlock Text="アプリ" Margin="0,24,0,4"
                           FontFamily="Yu Gothic UI Semibold" FontSize="17"
                           Foreground="{StaticResource InkBrush}" />
                <CheckBox x:Name="StartupCheckBox" Content="Windowsへのサインイン時に起動"
                          Checked="SettingChanged" Unchecked="SettingChanged" />

                <TextBlock Text="Astelio IME 1.0.8  •  Geek Fujiwara  •  MIT License"
                           Margin="0,24,0,0" Foreground="{StaticResource MutedBrush}"
                           FontFamily="Yu Gothic UI" FontSize="11" />

                <Border x:Name="ErrorPanel" Visibility="Collapsed" Background="#FFF1E8"
                        BorderBrush="#C95E25" BorderThickness="1" CornerRadius="4"
                        Padding="14" Margin="0,20,0,0">
                    <TextBlock x:Name="ErrorText" Foreground="#77300E" TextWrapping="Wrap"
                               FontFamily="Yu Gothic UI" FontSize="12" />
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" BorderBrush="#D5DCD5" BorderThickness="0,1,0,0"
                Background="#FAFBF9" Padding="32,14">
            <Grid>
                <TextBlock x:Name="SaveStatusText" Text="変更は自動保存されます"
                           Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"
                           FontFamily="Yu Gothic UI" FontSize="12" />
                <Button Content="通知領域に隠す" HorizontalAlignment="Right" Click="CloseButton_Click" />
            </Grid>
        </Border>
    </Grid>
</Window>
