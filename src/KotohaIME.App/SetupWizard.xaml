<Window x:Class="KotohaIME.App.SetupWizard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Astelio IME セットアップ" Icon="Assets/AstelioIME.ico" Width="860" Height="570"
        MinWidth="760" MinHeight="520" ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen" WindowStyle="None"
        AllowsTransparency="True" Background="Transparent">
    <Window.Resources>
        <Style x:Key="WizardButton" TargetType="Button">
            <Setter Property="FontFamily" Value="Yu Gothic UI Semibold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="20,10" />
            <Setter Property="MinWidth" Value="104" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.86" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="WizardCheckBox" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Margin" Value="0,10" />
        </Style>
    </Window.Resources>

    <Border CornerRadius="8" BorderBrush="#406E6963" BorderThickness="1">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#102B2A" Offset="0" />
                <GradientStop Color="#17685F" Offset="0.52" />
                <GradientStop Color="#D56F4B" Offset="1" />
            </LinearGradientBrush>
        </Border.Background>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="30,32,24,32">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="ASTELIO" Foreground="#F7FFFC"
                               FontFamily="Yu Gothic UI Semibold" FontSize="25" />
                    <TextBlock Text="INPUT, YOUR WAY" Foreground="#A9D7CE"
                               FontFamily="Yu Gothic UI" FontSize="11" Margin="1,3,0,0" />
                </StackPanel>

                <StackPanel Grid.Row="1" VerticalAlignment="Center">
                    <StackPanel x:Name="StepOneMarker" Orientation="Horizontal" Margin="0,10">
                        <Border x:Name="StepOneCircle" Width="30" Height="30" CornerRadius="15" Background="White">
                            <TextBlock Text="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="#16584F" FontFamily="Yu Gothic UI Semibold" />
                        </Border>
                        <TextBlock Text="はじめに" Margin="12,0,0,0" VerticalAlignment="Center"
                                   Foreground="White" FontFamily="Yu Gothic UI Semibold" FontSize="14" />
                    </StackPanel>
                    <Border Width="1" Height="22" Margin="14,0,0,0" HorizontalAlignment="Left" Background="#70FFFFFF" />
                    <StackPanel x:Name="StepTwoMarker" Orientation="Horizontal" Margin="0,10" Opacity="0.55">
                        <Border x:Name="StepTwoCircle" Width="30" Height="30" CornerRadius="15" BorderBrush="White" BorderThickness="1">
                            <TextBlock Text="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="White" FontFamily="Yu Gothic UI Semibold" />
                        </Border>
                        <TextBlock Text="入力スタイル" Margin="12,0,0,0" VerticalAlignment="Center"
                                   Foreground="White" FontFamily="Yu Gothic UI Semibold" FontSize="14" />
                    </StackPanel>
                    <Border Width="1" Height="22" Margin="14,0,0,0" HorizontalAlignment="Left" Background="#70FFFFFF" />
                    <StackPanel x:Name="StepThreeMarker" Orientation="Horizontal" Margin="0,10" Opacity="0.55">
                        <Border x:Name="StepThreeCircle" Width="30" Height="30" CornerRadius="15" BorderBrush="White" BorderThickness="1">
                            <TextBlock Text="3" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="White" FontFamily="Yu Gothic UI Semibold" />
                        </Border>
                        <TextBlock Text="起動と常駐" Margin="12,0,0,0" VerticalAlignment="Center"
                                   Foreground="White" FontFamily="Yu Gothic UI Semibold" FontSize="14" />
                    </StackPanel>
                </StackPanel>

                <TextBlock Grid.Row="2" Text="Astelio IME  •  ARM64 ready"
                           Foreground="#B9DDD6" FontFamily="Yu Gothic UI" FontSize="11" />
            </Grid>

            <Border Grid.Column="1" Margin="0" Background="#F8FBF9" CornerRadius="8">
                <Grid Margin="46,38,42,30">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid x:Name="WelcomePage">
                            <StackPanel VerticalAlignment="Center">
                                <Border Width="64" Height="64" CornerRadius="18" HorizontalAlignment="Left" Margin="0,0,0,24">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#17685F" Offset="0" />
                                            <GradientStop Color="#E07A52" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <TextBlock Text="A" Foreground="White" FontSize="31"
                                               FontFamily="Yu Gothic UI Semibold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="Astelio IMEへようこそ" FontFamily="Yu Gothic UI Semibold"
                                           FontSize="30" Foreground="#1B2825" />
                                <TextBlock Text="いつものMS-IMEに、あなたの入力スタイルを加えます。"
                                           FontFamily="Yu Gothic UI" FontSize="15" Foreground="#53645F"
                                           Margin="0,14,0,0" TextWrapping="Wrap" />
                                <TextBlock Text="数ステップで初期設定が完了します。"
                                           FontFamily="Yu Gothic UI" FontSize="13" Foreground="#73817D"
                                           Margin="0,8,0,0" />
                            </StackPanel>
                        </Grid>

                        <Grid x:Name="InputPage" Visibility="Collapsed">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="入力スタイル" FontFamily="Yu Gothic UI Semibold"
                                           FontSize="27" Foreground="#1B2825" />
                                <TextBlock Text="よく使う文字と切替キーの動作を選択します。"
                                           FontFamily="Yu Gothic UI" FontSize="13" Foreground="#65736F"
                                           Margin="0,8,0,18" />
                                <CheckBox x:Name="WizardAsciiCheckBox" Style="{StaticResource WizardCheckBox}"
                                          Content="英字・数字・指定記号を半角にする（MS-IME変換は維持）" />
                                <CheckBox x:Name="WizardPunctuationCheckBox" Style="{StaticResource WizardCheckBox}"
                                          Content="「 」 ！ ？ ・ 。も半角にする" />
                                <Separator Margin="0,12" Background="#D9E2DD" />
                                <CheckBox x:Name="WizardLeftAltCheckBox" Style="{StaticResource WizardCheckBox}"
                                          Content="左Altの単独押しで英語入力へ切り替える" />
                                <CheckBox x:Name="WizardRightAltCheckBox" Style="{StaticResource WizardCheckBox}"
                                          Content="右Altの単独押しで日本語入力へ切り替える" />
                            </StackPanel>
                        </Grid>

                        <Grid x:Name="StartupPage" Visibility="Collapsed">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="起動と常駐" FontFamily="Yu Gothic UI Semibold"
                                           FontSize="27" Foreground="#1B2825" />
                                <TextBlock Text="Astelio IMEを使い始める準備はあと少しです。"
                                           FontFamily="Yu Gothic UI" FontSize="13" Foreground="#65736F"
                                           Margin="0,8,0,22" />
                                <Border Background="#E9F4EF" BorderBrush="#BED9CD" BorderThickness="1"
                                        CornerRadius="6" Padding="18,14" Margin="0,0,0,14">
                                    <CheckBox x:Name="WizardStartupCheckBox" Style="{StaticResource WizardCheckBox}"
                                              Margin="0" Content="Windowsへのサインイン時に自動起動する" />
                                </Border>
                                <TextBlock Text="起動後は通知領域に常駐します。設定画面を閉じても入力カスタマイズは動作し続けます。"
                                           FontFamily="Yu Gothic UI" FontSize="13" Foreground="#65736F"
                                           TextWrapping="Wrap" LineHeight="21" />
                                <Border x:Name="WizardErrorPanel" Visibility="Collapsed" Background="#FFF0E9"
                                        BorderBrush="#D56F4B" BorderThickness="1" CornerRadius="5"
                                        Padding="12" Margin="0,18,0,0">
                                    <TextBlock x:Name="WizardErrorText" Foreground="#7A321D"
                                               FontFamily="Yu Gothic UI" FontSize="12" TextWrapping="Wrap" />
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,24,0,0">
                        <Button x:Name="CancelButton" Content="キャンセル" HorizontalAlignment="Left"
                                Style="{StaticResource WizardButton}" Background="Transparent"
                                BorderBrush="#BEC9C4" Foreground="#53645F" Click="CancelButton_Click" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="BackButton" Content="戻る" Visibility="Collapsed" Margin="0,0,10,0"
                                    Style="{StaticResource WizardButton}" Background="#E8EEEB"
                                    BorderBrush="#D2DDD8" Foreground="#344641" Click="BackButton_Click" />
                            <Button x:Name="NextButton" Content="次へ" Style="{StaticResource WizardButton}"
                                    Background="#17685F" BorderBrush="#17685F" Foreground="White"
                                    Click="NextButton_Click" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>