{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "windows-base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "windows-arm64",
      "displayName": "Windows ARM64",
      "inherits": "windows-base",
      "architecture": { "value": "ARM64", "strategy": "set" }
    },
    {
      "name": "windows-x64",
      "displayName": "Windows x64",
      "inherits": "windows-base",
      "architecture": { "value": "x64", "strategy": "set" }
    },
    {
      "name": "windows-x86",
      "displayName": "Windows x86",
      "inherits": "windows-base",
      "architecture": { "value": "Win32", "strategy": "set" }
    },
    {
      "name": "macos-universal",
      "displayName": "macOS Universal 2",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_OSX_ARCHITECTURES": "arm64;x86_64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "13.0"
      }
    }
  ],
  "buildPresets": [
    { "name": "windows-arm64", "configurePreset": "windows-arm64", "configuration": "Release" },
    { "name": "windows-x64", "configurePreset": "windows-x64", "configuration": "Release" },
    { "name": "windows-x86", "configurePreset": "windows-x86", "configuration": "Release" },
    { "name": "macos-universal", "configurePreset": "macos-universal" }
  ],
  "testPresets": [
    {
      "name": "test-base",
      "hidden": true,
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    },
    { "name": "windows-arm64", "inherits": "test-base", "configurePreset": "windows-arm64", "configuration": "Release" },
    { "name": "windows-x64", "inherits": "test-base", "configurePreset": "windows-x64", "configuration": "Release" },
    { "name": "windows-x86", "inherits": "test-base", "configurePreset": "windows-x86", "configuration": "Release" },
    { "name": "macos-universal", "inherits": "test-base", "configurePreset": "macos-universal" }
  ]
}
